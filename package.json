{
  "name": "dsh-seeker-bot",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的对话体验增强套件：思考折叠、工具调用聚合、html/iu 卡片、对话截图与下载，外加供应商中心、记忆/技能/连接器/用量/画廊/档案八个工作台与 Personal Agent（主 Bot/子 Bot/群聊/期刊日记/通话）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "connectors",
    "mcp",
    "memory",
    "workbench",
    "vault",
    "provider",
    "usage",
    "chat-plus",
    "seeker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kr-ATG/dsh-seeker-bot.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./packages/*": "./packages/*/index.js",
    "./packages/*/locale/zh.json": "./packages/*/locale/zh.json",
    "./packages/*/locale/en.json": "./packages/*/locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "packages",
    "locale",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs && node scripts/smoke-triad-client.mjs && node scripts/smoke-triad-host.mjs && node scripts/test-session-isolation.mjs && node scripts/test-browser-on-demand.mjs && node scripts/test-html-card-width.mjs && node scripts/test-settings-card.mjs && node scripts/test-running-apps.mjs && node scripts/test-at-guard.mjs && node scripts/test-turn-input-images.mjs && node scripts/test-prompt-optimize-clean.mjs && node scripts/test-vault.mjs && node scripts/test-vault-http.mjs && node scripts/test-system-prompt.mjs && node scripts/test-scrollbar-autohide.mjs && node scripts/test-usage-hours.mjs && node scripts/test-feature-switches.mjs && node scripts/test-published-reasoning.mjs && node scripts/test-echo-viewport.mjs && node scripts/test-mode-switch.mjs && node scripts/test-bot-install.mjs && node scripts/test-personal-agent.mjs",
    "test:mode-switch": "node scripts/test-mode-switch.mjs",
    "test:install": "node scripts/test-bot-install.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:triad-client": "node scripts/smoke-triad-client.mjs",
    "smoke:triad-host": "node scripts/smoke-triad-host.mjs",
    "test": "node scripts/test-skill-manager.mjs && node scripts/test-skill-preview.mjs && node scripts/test-skill-toggles.mjs && node scripts/test-subagent-catalog.mjs && node scripts/test-capabilities-stats.mjs && node scripts/test-web-search-chain.mjs",
    "test:web-search-chain": "node scripts/test-web-search-chain.mjs",
    "test:capabilities": "node scripts/test-capabilities-stats.mjs",
    "test:skill-preview": "node scripts/test-skill-preview.mjs",
    "test:subagents": "node scripts/test-subagent-catalog.mjs",
    "test:session-isolation": "node scripts/test-session-isolation.mjs",
    "test:browser-on-demand": "node scripts/test-browser-on-demand.mjs",
    "test:browser-activity": "node scripts/test-browser-activity.mjs",
    "test:browser-flag": "node scripts/test-browser-flag.mjs",
    "test:echo-viewport": "node scripts/test-echo-viewport.mjs",
    "test:html-card-width": "node scripts/test-html-card-width.mjs",
    "test:running-apps": "node scripts/test-running-apps.mjs",
    "test:at-guard": "node scripts/test-at-guard.mjs",
    "test:turn-input-images": "node scripts/test-turn-input-images.mjs",
    "test:prompt-optimize": "node scripts/test-prompt-optimize-clean.mjs",
    "test:vault": "node scripts/test-vault.mjs",
    "test:vault-http": "node scripts/test-vault-http.mjs",
    "test:system-prompt": "node scripts/test-system-prompt.mjs",
    "test:scrollbar-autohide": "node scripts/test-scrollbar-autohide.mjs",
    "test:usage-hours": "node scripts/test-usage-hours.mjs",
    "test:feature-switches": "node scripts/test-feature-switches.mjs",
    "test:published-reasoning": "node scripts/test-published-reasoning.mjs",
    "build:personal-demo": "node scripts/build-personal-demo.mjs",
    "test:personal-agent": "node scripts/test-personal-agent.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.4.3",
    "ssh2": "^1.17.0",
    "yauzl": "^2.10.0"
  },
  "icon": "./icon.png",
  "author": "Kr-ATG"
}
